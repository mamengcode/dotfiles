# Local and machine-specific files
.DS_Store
*.local
*.log
*.session
*.tmp

# Chezmoi state, caches, and generated files
.chezmoi.*
.zcompdump*

# Never track credentials or private key material
private_dot_ssh/id_*
private_dot_ssh/*.pem
private_dot_ssh/*.key
private_dot_ssh/known_hosts*
*.pem
*.key
*.p12
*.pfx
.env
.env.*
